# The platform taken from Trawler: the screen, a key, MASTER, the lights.
wait 50
shot boot.png
expect blits >0
wav keys.wav
key w0 down
wait 300
expect lit_keys 1
key w0 up
key C4
key G4
master 1024
key C5
wait 400
wavstop
expect peak >1000
expect lit_keys 0
